# Copy this file to .env and fill in your own values.
# cp .env.example .env

# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Comma-separated list is NOT supported by the current CORS setup — it's a
# single origin. Point this at your deployed frontend (no trailing slash!).
FRONTEND_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kisanmitra

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-in-production

# ── AI / third-party API keys (all optional — features fall back
#    to rule-based logic or mock data when a key is missing) ───
GEMINI_API_KEY=your_gemini_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
GROQ_API_KEY=your_groq_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here
